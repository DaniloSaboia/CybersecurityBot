# ============================================================================
# Sentinel KMS — environment template.  Copy to `.env` and fill in.
#   cp .env.example .env
# ============================================================================

# ---- Which AI provider stack to use ----------------------------------------
# "mistral" = Mistral cloud API (needs MISTRAL_API_KEY).
# "local"   = Ollama running locally / in the `ollama` compose service.
# This selects the Spring profile for the backend.
SPRING_PROFILES_ACTIVE=mistral

# ---- Database (local Supabase CLI Postgres) --------------------------------
# `supabase start` exposes Postgres on host port 54322 (user/pass: postgres).
# Containers reach the host via host.docker.internal.
DB_URL=jdbc:postgresql://host.docker.internal:54322/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- Mistral (used when SPRING_PROFILES_ACTIVE=mistral) ---------------------
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed

# ---- Ollama (used when SPRING_PROFILES_ACTIVE=local) ------------------------
# When running the bundled `ollama` service, base-url is http://ollama:11434.
# Pull the models first:  docker compose exec ollama ollama pull llama3.1
#                         docker compose exec ollama ollama pull mxbai-embed-large
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=mxbai-embed-large

# ---- Embedding dimension ---------------------------------------------------
# Both mistral-embed and mxbai-embed-large emit 1024-dim vectors, so the
# pgvector schema is fixed at 1024. Change this AND the migration if you swap
# to a model with a different dimension (then re-embed everything).
EMBEDDING_DIMENSIONS=1024

# ---- RAG tuning ------------------------------------------------------------
RAG_TOP_K=6
RAG_MIN_SCORE=0.30

# ---- Frontend --------------------------------------------------------------
# Base path the React app calls; Vite dev server proxies /api -> backend.
VITE_API_BASE=/api
