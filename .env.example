# ==============================================================================
# Sentinel KMS — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Selection (openrouter | mistral | local)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=openrouter

# --- OpenRouter (Recommended: Free high-quality models) ---
# Get a key at https://openrouter.ai/keys. Authentication is required even
# when the selected model has zero token cost.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# The router and Settings endpoint follow OpenRouter's changing live catalog.
OPENROUTER_CHAT_MODEL=openrouter/free

# --- Mistral AI (Cloud Inference & 1024-dim Embeddings) ---
# Required by the openrouter profile for ingestion and RAG query embeddings.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed

# --- Ollama (Local LLMs) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=mxbai-embed-large

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Hosted Cloud OR Local)
# ------------------------------------------------------------------------------
# Hosted Supabase Example:
#   Project URL: https://xyzcompany.supabase.co
#   DB Host: copy the Session pooler host shown in the Connect dialog
#   JWKS: https://xyzcompany.supabase.co/auth/v1/.well-known/jwks.json

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Backend JDBC Database Connection. The Session pooler supports IPv4 and is
# appropriate for Hikari's long-lived connections. Copy its exact host/region.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=your-supabase-db-password

# Supabase Auth JWT Validation
SUPABASE_JWKS_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://<your-project-ref>.supabase.co/auth/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. RAG Search & Ingestion Parameters
# ------------------------------------------------------------------------------
RAG_TOP_K=6
RAG_MIN_SCORE=0.30
RAG_HISTORY_TURNS=4
# Rewrite multi-turn follow-ups into standalone retrieval questions (fail-open).
RAG_QUERY_REWRITE=true
# LLM relevance re-ranking of the fused candidate window (extra model call).
RAG_RERANK=false
RAG_RERANK_WINDOW=10
# Per-user, per-minute rate caps on the chat + ingest endpoints.
RATELIMIT_CHAT_PER_MINUTE=12
RATELIMIT_INGEST_PER_MINUTE=6
# The migration is fixed at 1024 dimensions. Changing embedding models may
# require rebuilding vector_store with the new dimension.

# ------------------------------------------------------------------------------
# 4. Observability
# ------------------------------------------------------------------------------
# /actuator/prometheus requires auth by default; open only behind trusted networks.
METRICS_OPEN=false
# One JSON object per log line (on by default in the Docker image).
LOG_JSON=false

# ------------------------------------------------------------------------------
# 5. Optional Feed Connectors
# ------------------------------------------------------------------------------
NVD_SYNC_ENABLED=false
NVD_API_KEY=
