{
  "name": "sentinel-kms-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --port 5173",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:real": "CI=1 SENTINEL_REAL_STACK_E2E=1 node e2e/real-stack-preflight.js && CI=1 SENTINEL_REAL_STACK_E2E=1 npm run build && CI=1 SENTINEL_REAL_STACK_E2E=1 playwright test -c playwright.real.config.js --project=chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
