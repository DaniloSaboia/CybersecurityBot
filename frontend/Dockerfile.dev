# Dev-server image: runs Vite with an /api proxy to the backend container.
# Used by docker-compose for local development (hot reload, .env sharing).
FROM node:24.20.0-alpine
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
